# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Render provides this as the database's
# "Internal Database URL".
DATABASE_URL=postgres://localhost:5432/pulse_monitor
# Use SSL for the database connection (defaults to true in production).
# DATABASE_SSL=true

# Secret for signing session tokens. At least 32 random characters in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Public URL of the web app (reset links, CSRF origin check).
APP_URL=http://localhost:5174

# Resend: leave empty in development to print reset emails to the server log.
RESEND_API_KEY=
EMAIL_FROM=Pulse Monitor <onboarding@resend.dev>

# Run the check scheduler inside the API process.
RUN_SCHEDULER=true

# Allow monitors that target localhost or private networks. Keep false in production.
ALLOW_PRIVATE_TARGETS=false

# Serve client/dist from Express (defaults to true in production).
# SERVE_CLIENT=true

# debug | info | warn | error
# LOG_LEVEL=info
